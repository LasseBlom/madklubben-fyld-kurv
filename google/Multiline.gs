/** Multilines varer som rækker til arket (samme kolonner som KOLONNER i Kode.gs). */
function multilineRaekker_() {
  const listeNr = Object.keys(ML_LISTER);
  return ML_VARER.map((v, i) => {
    const [liste, varenr, kode, pakning, navn, kategori, billede, id] = v;
    const [omraade, listeNavn] = ML_LISTER[liste];
    const enhed = (ML_ENHED[kode] || 'enhed') + (pakning ? ' (' + pakning + ')' : '');
    const nr = varenr.replace(/#.*/, '');
    const kat = Math.max(0, ML_KATEGORIER.indexOf(kategori));
    const sortering = 1000 + listeNr.indexOf(liste) * 100000 + kat * 1000 + i;
    return [
      id || ('ml-' + liste + '-' + varenr.toLowerCase().replace('#', '-v')),
      'Multiline', kategori, navn, 'Varenr. ' + nr, enhed, varenr,
      'https://d213yzj61vi89h.cloudfront.net/Bunzl-MLN-Site/images/1XS/' + (billede || nr + '.jpg'),
      '', sortering, omraade, listeNavn,
    ];
  });
}
